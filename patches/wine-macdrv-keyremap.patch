+/* FEX for Mac: names accepted in the KeyRemap option, with their Mac virtual keycodes (kVK_*). */
+static const struct { const char *name; unsigned char keycode; } key_names[] =
+{
+    {"a",0x00},{"s",0x01},{"d",0x02},{"f",0x03},{"h",0x04},{"g",0x05},{"z",0x06},{"x",0x07},{"c",0x08},
+    {"v",0x09},{"b",0x0b},{"q",0x0c},{"w",0x0d},{"e",0x0e},{"r",0x0f},{"y",0x10},{"t",0x11},{"1",0x12},
+    {"2",0x13},{"3",0x14},{"4",0x15},{"6",0x16},{"5",0x17},{"equal",0x18},{"9",0x19},{"7",0x1a},
+    {"minus",0x1b},{"8",0x1c},{"0",0x1d},{"rightbracket",0x1e},{"o",0x1f},{"u",0x20},{"leftbracket",0x21},
+    {"i",0x22},{"p",0x23},{"return",0x24},{"enter",0x24},{"l",0x25},{"j",0x26},{"quote",0x27},{"k",0x28},
+    {"semicolon",0x29},{"backslash",0x2a},{"comma",0x2b},{"slash",0x2c},{"n",0x2d},{"m",0x2e},
+    {"period",0x2f},{"tab",0x30},{"space",0x31},{"grave",0x32},{"backspace",0x33},{"escape",0x35},
+    {"esc",0x35},{"command",0x37},{"cmd",0x37},{"shift",0x38},{"capslock",0x39},{"option",0x3a},
+    {"alt",0x3a},{"control",0x3b},{"ctrl",0x3b},{"rightshift",0x3c},{"rightoption",0x3d},
+    {"rightalt",0x3d},{"rightcontrol",0x3e},{"rightctrl",0x3e},{"f5",0x60},{"f6",0x61},{"f7",0x62},
+    {"f3",0x63},{"f8",0x64},{"f9",0x65},{"f11",0x67},{"f10",0x6d},{"f12",0x6f},{"home",0x73},
+    {"pageup",0x74},{"delete",0x75},{"f4",0x76},{"end",0x77},{"f2",0x78},{"pagedown",0x79},{"f1",0x7a},
+    {"left",0x7b},{"right",0x7c},{"down",0x7d},{"up",0x7e},
+};
 
+static int key_name_to_keycode(const WCHAR *name, int len)
+{
+    char lower[16];
+    unsigned int i;
 
+    while (len && name[0] == ' ') { name++; len--; }
+    while (len && name[len - 1] == ' ') len--;
+    if (!len || len >= sizeof(lower)) return -1;
+    for (i = 0; i < len; i++)
+    {
+        if (name[i] > 0x7f) return -1;
+        lower[i] = (name[i] >= 'A' && name[i] <= 'Z') ? name[i] + 32 : name[i];
+    }
+    lower[len] = 0;
+    for (i = 0; i < ARRAY_SIZE(key_names); i++)
+        if (!strcmp(lower, key_names[i].name)) return key_names[i].keycode;
+    return -1;
+}
+
+/* KeyRemap = "Space=Shift, Z=J": pressing the key on the left acts as the key on the right. */
+static void parse_key_remap(const WCHAR *spec)
+{
+    const WCHAR *entry = spec;
+
+    memset(key_remap, 0, sizeof(key_remap));
+    while (*entry)
+    {
+        const WCHAR *end = entry, *eq = NULL;
+        int from, to;
+
+        while (*end && *end != ',' && *end != ';') { if (*end == '=' && !eq) eq = end; end++; }
+        if (eq)
+        {
+            from = key_name_to_keycode(entry, eq - entry);
+            to = key_name_to_keycode(eq + 1, end - eq - 1);
+            if (from >= 0 && to >= 0) key_remap[from] = to + 1;
+            else WARN("ignoring KeyRemap entry %s\n", debugstr_wn(entry, end - entry));
+        }
+        entry = *end ? end + 1 : end;
+    }
+}
