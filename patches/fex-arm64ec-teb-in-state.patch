+// VKMT: Wine fills each EC module's __os_arm64x_dispatch_{call_no_redirect,fptr,ret} slots with this emulator's entry points when the
+// module is loaded. Modules loaded before the emulator (kernelbase, pulled in by the emulator's own C++ runtime imports) got NULL there,
+// so any of their functions called from x86 code jumped to address 0 on return. Fill those slots in for everything already loaded.
+void PatchEarlyLoadedModules() {
+  const auto Self = reinterpret_cast<uintptr_t>(&__ImageBase);
+  const auto* Ldr = reinterpret_cast<const uint8_t*>(reinterpret_cast<__TEB*>(NtCurrentTeb())->Peb->LdrData);
+  // PEB_LDR_DATA::InMemoryOrderModuleList is at +0x20, LDR_DATA_TABLE_ENTRY::DllBase is 0x20 bytes after InMemoryOrderLinks.
+  const auto* ListHead = reinterpret_cast<const LIST_ENTRY*>(Ldr + 0x20);
+  for (auto* Link = ListHead->Flink; Link != ListHead; Link = Link->Flink) {
+    const auto Module = *reinterpret_cast<HMODULE const*>(reinterpret_cast<const uint8_t*>(Link) + 0x20);
+    if (!Module || reinterpret_cast<uintptr_t>(Module) == Self) {
+      continue;
+    }
+
+    ULONG Size;
+    const auto* LoadConfig =
+      reinterpret_cast<_IMAGE_LOAD_CONFIG_DIRECTORY64*>(RtlImageDirectoryEntryToData(Module, true, IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG, &Size));
+    if (!LoadConfig || Size <= offsetof(_IMAGE_LOAD_CONFIG_DIRECTORY64, CHPEMetadataPointer) || !LoadConfig->CHPEMetadataPointer) {
+      continue;
+    }
+
+    const auto* NtHeaders = RtlImageNtHeader(Module);
+    const auto ModuleBase = reinterpret_cast<uintptr_t>(Module);
+    if (!NtHeaders || LoadConfig->CHPEMetadataPointer <= ModuleBase || LoadConfig->CHPEMetadataPointer >= ModuleBase + NtHeaders->OptionalHeader.SizeOfImage) {
+      continue;
+    }
+
+    const auto* CHPEMetadata = reinterpret_cast<IMAGE_ARM64EC_METADATA*>(LoadConfig->CHPEMetadataPointer);
+    WriteModuleRVA(Module, CHPEMetadata->__os_arm64x_dispatch_call_no_redirect, &ExitToX64);
+    WriteModuleRVA(Module, CHPEMetadata->__os_arm64x_dispatch_fptr, &DispatchJump);
+    WriteModuleRVA(Module, CHPEMetadata->__os_arm64x_dispatch_ret, &RetToEntryThunk);
+  }
+}
