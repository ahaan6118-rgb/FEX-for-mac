+void PatchEarlyLoadedModules() {
+  const auto Self = reinterpret_cast<uintptr_t>(&__ImageBase);
+  const auto* Ldr = reinterpret_cast<const uint8_t*>(reinterpret_cast<__TEB*>(NtCurrentTeb())->Peb->LdrData);
