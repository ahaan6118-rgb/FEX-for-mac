+// The guard regions must be a whole host page. Apple silicon protects memory in 16KiB units, so a
+// 4KiB FEX_PAGE_SIZE guard sits inside a page that Wine commits together with the stack and is
+// silently writable: an unbalanced call/ret sequence then runs through the guard and faults on the
+// unmapped hole below the reservation, where HandleAccessViolation does not recognise the address.
+constexpr uint64_t CallRetGuardSize = 0x4000;
+
 CallRetStackInfo GetInfoThread(FEXCore::Core::InternalThreadState* Thread) {
   uint64_t Base = reinterpret_cast<uint64_t>(Thread->CallRetStackBase);
   // Leave some room from the base for the default location to allow for underflows without constant exceptions
-  return {Base - FEXCore::Utils::FEX_PAGE_SIZE, Base + FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE + FEXCore::Utils::FEX_PAGE_SIZE,
+  return {Base - CallRetGuardSize, Base + FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE + CallRetGuardSize,
           Base + FEXCore::Core::InternalThreadState::CALLRET_DEFAULT_OFFSET};
 }
 
@@ -88,7 +94,7 @@
 #endif
 
