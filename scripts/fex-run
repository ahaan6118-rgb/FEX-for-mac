#!/bin/bash
# fex-run - run any Windows program through Wine + FEX, with optional per-program profiles.
#
#   fex-run [--prefix DIR] [--no-profile] <program.exe | C:\path\program.exe> [program args...]
#
# Lives in FEXforMac.app/Contents/Resources/bin. Used by the FEX for Mac GUI for every program, and by
# launcher apps such as "Steam (FEX).app" (scripts/make-launcher.sh).
#
# A profile (Resources/profiles/*.profile, plain shell variables) is picked by the program's file name and can
#   * add command line flags the program needs under emulation        (EXTRA_ARGS)
#   * recover from a later freeze of one helper process                (RECOVER_KILL)
#   * set extra environment variables, e.g. FEX options              (EXTRA_ENV)
#   * quit the program politely so it saves its state                  (QUIT_ARGS)
#   * start another program afterwards, or instead of this one        (POST_RUN, SKIP_IF_EXISTS)
#   * choose its Wine DLL overrides                                    (DLLOVERRIDES)
#   * refuse a second copy while one is already running                (SINGLE_INSTANCE_PATTERN)
#   * restart the program when it freezes or dies early                (WATCH_LOG, HANG_PATTERN, OK_LOG, OK_PATTERN)
# so nothing here is specific to one program. See profiles/steam.profile for an example.
#
# Environment: FEX_PREFIX / WINEPREFIX (prefix dir, default ~/.fex-for-mac), FEX_RUN_LOG (log file),
#              FEX_DLLOVERRIDES (overrides the profile's / default Wine DLL overrides),
#              FEX_NO_PROFILE=1 (same as --no-profile), FEX_WINEDEBUG (default -all).

PREFIX_ARG=""
NO_PROFILE="${FEX_NO_PROFILE:-0}"
while [ $# -gt 0 ]; do
    case "$1" in
        --prefix) PREFIX_ARG="$2"; shift 2 ;;
        --no-profile) NO_PROFILE=1; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[ $# -ge 1 ] || { echo "usage: fex-run [--prefix DIR] [--no-profile] <program.exe> [args...]" >&2; exit 2; }
PROGRAM="$1"; shift

SELF="$(cd "$(dirname "$0")" && pwd)"
RES="$(cd "$SELF/.." && pwd)"
CONTENTS="$(cd "$RES/.." && pwd)"
WINE_DIR="$RES/wine"
export WINEPREFIX="${PREFIX_ARG:-${FEX_PREFIX:-${WINEPREFIX:-$HOME/.fex-for-mac}}}"
LOG="${FEX_RUN_LOG:-$HOME/Library/Logs/FEXforMac.log}"
mkdir -p "$(dirname "$LOG")"

log() { echo "$(date '+%F %T') fex-run: $*" >>"$LOG"; }
note() { /usr/bin/osascript -e "display notification \"$1\" with title \"FEX for Mac\"" >/dev/null 2>&1; }

[ -x "$WINE_DIR/bin/wine" ] || { echo "fex-run: no Wine in $WINE_DIR" >&2; exit 1; }

# --- environment (kept identical to the GUI's makeWineEnv) ------------------------------------------------
export WINESERVER="$WINE_DIR/bin/wineserver"
export WINELOADERNOEXEC=1
export WINEDEBUG="${FEX_WINEDEBUG:--all}"
export DYLD_LIBRARY_PATH="$WINE_DIR/lib:$CONTENTS/Frameworks"
export DYLD_FALLBACK_LIBRARY_PATH="$CONTENTS/Frameworks:$WINE_DIR/lib:/usr/lib"
export VK_ICD_FILENAMES="$RES/vulkan/icd.d/MoltenVK_icd.json"
export VK_DRIVER_FILES="$RES/vulkan/icd.d/MoltenVK_icd.json"
export MVK_CONFIG_USE_METAL_ARGUMENT_BUFFERS=1
export PATH="$WINE_DIR/bin:$PATH"
# FEX's half-barrier TSO makes unaligned accesses non-atomic; Chromium-based programs then deadlock at startup.
# FEX reads FEX_* options from the environment, and the prefix registry carries the same value for other launchers.
export FEX_HALFBARRIERTSOENABLED="${FEX_HALFBARRIERTSOENABLED:-0}"
# x87 in 64-bit precision loses the low bits of FILD/FISTP qword round trips, which Delphi's Move() uses to copy
# 8 bytes at a time: every Delphi/GameMaker program then corrupts its strings (paths, texts).
export FEX_X87REDUCEDPRECISION="${FEX_X87REDUCEDPRECISION:-0}"

# --- prefix extras (rsaenh, oleacc, nsiproxy, vulkan-1 override), once per prefix ----------------------------------
EXTRAS="$RES/scripts/prefix-extras.sh"
MARK="$WINEPREFIX/.fexformac-extras-1"
if [ -f "$WINEPREFIX/system.reg" ] && [ ! -f "$MARK" ] && [ -f "$EXTRAS" ]; then
    log "applying prefix extras to $WINEPREFIX"
    FEX_APP="$CONTENTS/.." bash "$EXTRAS" "$WINEPREFIX" >>"$LOG" 2>&1 && touch "$MARK"
fi

# Windows programs expect to start in their own folder (games look for "data" next to the exe)
if [ -f "$PROGRAM" ]; then cd "$(dirname "$PROGRAM")" 2>/dev/null; fi

# --- program path: unix path inside the prefix's C: drive -> C:\ path ----------------------------------------
TARGET="$PROGRAM"
case "$PROGRAM" in
    "$WINEPREFIX"/drive_c/*) rel="${PROGRAM#"$WINEPREFIX"/drive_c/}"; TARGET="C:\\${rel//\//\\}" ;;
esac
EXE_NAME="$(basename "${PROGRAM//\\//}" | tr '[:upper:]' '[:lower:]')"

# --- profile ---------------------------------------------------------------------------------------------------
EXTRA_ARGS=""; SINGLE_INSTANCE_PATTERN=""; WATCH_LOG=""; OK_LOG=""; HANG_PATTERN=""; OK_PATTERN=""; DLLOVERRIDES=""; RECOVER_KILL=""; EXTRA_ENV=""; QUIT_ARGS=""; POST_RUN=""; SKIP_IF_EXISTS=""
SETTLE=110; TRIES=4; EARLY_EXIT_SECS=60; PROFILE_NAME=""
if [ "$NO_PROFILE" != 1 ]; then
    for pf in "$RES"/profiles/*.profile; do
        [ -f "$pf" ] || continue
        MATCH_EXE=""
        # shellcheck disable=SC1090
        . "$pf"
        if [ "$(echo "$MATCH_EXE" | tr '[:upper:]' '[:lower:]')" = "$EXE_NAME" ]; then PROFILE_NAME="$(basename "$pf" .profile)"; break; fi
        EXTRA_ARGS=""; SINGLE_INSTANCE_PATTERN=""; WATCH_LOG=""; OK_LOG=""; HANG_PATTERN=""; OK_PATTERN=""; DLLOVERRIDES=""; RECOVER_KILL=""; EXTRA_ENV=""; QUIT_ARGS=""; POST_RUN=""; SKIP_IF_EXISTS=""
        SETTLE=110; TRIES=4; EARLY_EXIT_SECS=60
    done
fi
[ -n "$PROFILE_NAME" ] || { EXTRA_ARGS=""; SINGLE_INSTANCE_PATTERN=""; WATCH_LOG=""; OK_LOG=""; DLLOVERRIDES=""; RECOVER_KILL=""; EXTRA_ENV=""; QUIT_ARGS=""; POST_RUN=""; SKIP_IF_EXISTS=""; }
# per-program environment (e.g. FEX options such as FEX_TSOENABLED=0), "VAR=value VAR2=value" from the profile
for kv in $EXTRA_ENV; do export "$kv"; done
# DXMT (d3d11/dxgi -> Metal) by default; a profile can narrow this (Chromium programs start much faster without it)
export WINEDLLOVERRIDES="${FEX_DLLOVERRIDES:-${DLLOVERRIDES:-${WINEDLLOVERRIDES:-d3d11,dxgi=b;winemetal=b}}}"
[ -n "$PROFILE_NAME" ] && log "profile '$PROFILE_NAME' for $EXE_NAME"

if [ -n "$SINGLE_INSTANCE_PATTERN" ] && /usr/bin/pgrep -f "$SINGLE_INSTANCE_PATTERN" >/dev/null 2>&1; then
    log "$EXE_NAME is already running"
    note "$EXE_NAME is already running."
    exit 0
fi

# e.g. an installer whose product is already installed: run the installed program instead
if [ -n "$SKIP_IF_EXISTS" ] && [ -n "$POST_RUN" ] && [ -f "$WINEPREFIX/$SKIP_IF_EXISTS" ]; then
    log "$SKIP_IF_EXISTS is already installed - starting it instead of $EXE_NAME"
    exec "$SELF/fex-run" "$WINEPREFIX/$POST_RUN" "$@"
fi

WPID=""
# ask the program to quit by itself first (Steam saves its login on a clean exit), then force it
graceful_stop() {
    [ -n "$QUIT_ARGS" ] || return 0
    [ -n "$WPID" ] && kill -0 "$WPID" 2>/dev/null || return 0
    log "asking $EXE_NAME to quit ($QUIT_ARGS)"
    # shellcheck disable=SC2086
    ( "$WINE_DIR/bin/wine" "$TARGET" $QUIT_ARGS >/dev/null 2>&1 & )
    for ((gi = 0; gi < 40; gi++)); do kill -0 "$WPID" 2>/dev/null || return 0; sleep 1; done
    log "$EXE_NAME did not quit in time"
}
stop_all() { [ -n "$WPID" ] && kill "$WPID" 2>/dev/null; "$WINESERVER" -k 2>/dev/null; }
# die by the signal itself so callers see an ordinary termination (status 15), not an error
trap 'log "stopped"; graceful_stop; stop_all; trap - TERM; kill -s TERM $$' TERM INT HUP

# shellcheck disable=SC2086
run_once() { "$WINE_DIR/bin/wine" "$TARGET" $EXTRA_ARGS "$@" & WPID=$!; }

# no watchdog: plain run, pass the exit status through
if [ -z "$WATCH_LOG" ]; then
    log "run: $TARGET $EXTRA_ARGS $*"
    run_once "$@"
    wait "$WPID"; rc=$?
    log "exit status $rc"
    if [ -n "$POST_RUN" ] && [ -f "$WINEPREFIX/$POST_RUN" ]; then
        # e.g. Steam's installer starts Steam without our settings: stop that one and start it properly
        log "starting $POST_RUN with its own profile"
        "$WINESERVER" -k 2>/dev/null; sleep 3
        exec "$SELF/fex-run" "$WINEPREFIX/$POST_RUN"
    fi
    exit $rc
fi

# watchdog: the program must stay up for SETTLE seconds without HANG_PATTERN appearing in WATCH_LOG
WATCH_PATH="$WINEPREFIX/$WATCH_LOG"
OK_PATH="$WINEPREFIX/${OK_LOG:-$WATCH_LOG}"
STAMP="$(mktemp -t fexrun)"
try=1; healthy=0
while [ $try -le "$TRIES" ]; do
    log "attempt $try/$TRIES: $TARGET $EXTRA_ARGS $*"
    touch "$STAMP"; started=$SECONDS
    # logs may be appended to across runs: only look at what this attempt wrote
    ok_base=0; [ -f "$OK_PATH" ] && ok_base=$(wc -c < "$OK_PATH" | tr -d ' ')
    run_once "$@"

    bad=""
    for ((t = 0; t < SETTLE; t += 5)); do
        sleep 5
        if ! kill -0 "$WPID" 2>/dev/null; then
            wait "$WPID"; rc=$?
            if [ $((SECONDS - started)) -ge "$EARLY_EXIT_SECS" ]; then log "exit status $rc"; rm -f "$STAMP"; exit $rc; fi
            bad="exited early (status $rc after $((SECONDS - started))s)"; break
        fi
        if [ -f "$WATCH_PATH" ] && [ "$WATCH_PATH" -nt "$STAMP" ] && [ -n "$HANG_PATTERN" ] && grep -aq "$HANG_PATTERN" "$WATCH_PATH" 2>/dev/null; then
            bad="hung ('$HANG_PATTERN' in log)"; break
        fi
    done
    if [ -z "$bad" ] && [ -n "$OK_PATTERN" ]; then
        ok_size=0; [ -f "$OK_PATH" ] && ok_size=$(wc -c < "$OK_PATH" | tr -d ' ')
        [ "$ok_size" -lt "$ok_base" ] && ok_base=0     # file was rotated
        if ! { [ -f "$OK_PATH" ] && tail -c +$((ok_base + 1)) "$OK_PATH" 2>/dev/null | grep -aq "$OK_PATTERN"; }; then
            bad="never reached '$OK_PATTERN'"
        fi
    fi
    [ -z "$bad" ] && { healthy=1; log "healthy after $((SECONDS - started))s"; break; }

    log "attempt $try failed: $bad"
    try=$((try + 1))
    [ $try -le "$TRIES" ] && note "$EXE_NAME $bad - restarting (attempt $try of $TRIES)"
    stop_all; wait "$WPID" 2>/dev/null; sleep 3
done

if [ $healthy != 1 ]; then
    log "gave up after $TRIES attempts"
    note "$EXE_NAME kept failing at startup. Quit and try again."
    rm -f "$STAMP"; exit 1
fi

# healthy: keep watching. A later freeze of one helper process (HANG_PATTERN appears again) is cured by killing the
# newest process matching RECOVER_KILL; the program respawns it.
if [ -n "$RECOVER_KILL" ] && [ -n "$HANG_PATTERN" ]; then
    hang_base=$(grep -ac "$HANG_PATTERN" "$WATCH_PATH" 2>/dev/null || echo 0)
    while kill -0 "$WPID" 2>/dev/null; do
        sleep 3
        [ "$WATCH_PATH" -nt "$STAMP" ] || continue
        c=$(grep -ac "$HANG_PATTERN" "$WATCH_PATH" 2>/dev/null || echo 0)
        if [ "$c" -gt "$hang_base" ]; then
            victim=$(/usr/bin/pgrep -n -f "$RECOVER_KILL")
            log "freeze detected, killing newest '$RECOVER_KILL' (pid ${victim:-none})"
            [ -n "$victim" ] && kill -9 "$victim" 2>/dev/null
            hang_base=$c
        fi
    done
fi
wait "$WPID"; rc=$?
log "exit status $rc"
rm -f "$STAMP"
exit $rc
